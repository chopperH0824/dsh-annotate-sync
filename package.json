{
  "name": "dsh-annotate-sync",
  "version": "2.0.0",
  "description": "DeepSeek Harness HTML 文档预览就地批注插件：打开任意 HTML 预览即出现点选批注浮层，批注按文件保存，可整批发送给当前对话的 Agent，并通过 read_annotations 工具让 Agent 直接定位并修改源文件。In-place HTML document annotation for DeepSeek Harness: the overlay appears automatically in the document preview, annotations are saved per file, sent to the current conversation, and exposed to the agent through tools.",
  "type": "module",
  "license": "MIT",
  "author": "chopperH0824",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chopperH0824/dsh-annotate-sync.git"
  },
  "homepage": "https://github.com/chopperH0824/dsh-annotate-sync#readme",
  "bugs": {
    "url": "https://github.com/chopperH0824/dsh-annotate-sync/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "types",
    "locale",
    "demo",
    "docs/PROTOCOL.md",
    "docs/PUBLISH.md",
    "cordis.patch.yml",
    "icon.svg",
    "NOTICE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "annotation",
    "annotations",
    "html",
    "document-preview",
    "visual-feedback",
    "devtools",
    "标注",
    "批注"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/store.js && node --check lib/markdown.js && node --check lib/api.js && node --check lib/client.js && node --check lib/overlay.js",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-client-resources",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
